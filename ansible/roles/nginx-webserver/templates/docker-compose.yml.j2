networks:
  default:
    external: true
    name: specify_network

services:
  proxy:
    restart: unless-stopped
    image: "{{ nginx_proxy_image }}"
    init: true
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./certs:/etc/nginx/certs:ro
      - ./includes:/etc/nginx/includes:ro
      - ./conf.d:/etc/nginx/conf.d:ro
{% for instance in webserver_instances.split(',') %}
      - static-files-{{ instance | trim }}:/volumes/static-files-{{ instance | trim }}:ro
{% endfor %}

volumes:
{% for instance in webserver_instances.split(',') %}
  static-files-{{ instance | trim }}:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ volumes_root }}/static-files/{{ instance | trim }}"
{% endfor %}
